FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests org.apache.maven.plugins:maven-war-plugin:3.5.1:war

FROM tomcat:10.1.60-jre17-temurin
ENV PORT=10000
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /build/target/vehicontrol-api-1.0.0.war /usr/local/tomcat/webapps/ROOT.war
EXPOSE 10000
CMD ["sh", "-c", "sed -i \"s/port=\\\"8080\\\"/port=\\\"${PORT:-10000}\\\"/\" /usr/local/tomcat/conf/server.xml && exec catalina.sh run"]
